{
  "name": "reveal-rtl",
  "version": "0.5.5",
  "description": "Right-to-left (Persian) support plugin for reveal.js",
  "type": "module",
  "main": "plugin/rtl.js",
  "bin": {
    "reveal-rtl-lint": "bin/lint.js"
  },
  "exports": {
    ".": "./plugin/rtl.js",
    "./ui": "./plugin/ui.js",
    "./core": "./core/rtl.js",
    "./rtl.css": "./core/rtl.css",
    "./ui.css": "./core/ui.css",
    "./themes/*": "./themes/*"
  },
  "files": [
    "core/rtl.js",
    "core/speaker.js",
    "core/export.js",
    "core/help.js",
    "core/draw.js",
    "core/i18n.js",
    "core/lint.js",
    "bin",
    "core/rtl.css",
    "core/ui.css",
    "plugin",
    "dist",
    "fonts",
    "themes",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "esbuild plugin/rtl.js --bundle --format=iife --global-name=RevealRTL --footer:js=\"RevealRTL=RevealRTL.default;\" --outfile=dist/reveal-rtl.js && esbuild plugin/ui.js --bundle --format=iife --global-name=RevealRTLUI --footer:js=\"RevealRTLUI=RevealRTLUI.default;\" --outfile=dist/reveal-rtl-ui.js && node scripts/build-themes.js && node scripts/sync-skill.js && node scripts/build-gallery.js",
    "test": "node --test \"core/*.test.js\" \"create-reveal-rtl/*.test.js\"",
    "test:e2e": "playwright test",
    "lint:text": "node bin/lint.js demo index.html README.md CONTRIBUTING.md create-reveal-rtl/template gallery/src/thesis.md gallery/src/class.md gallery/src/report.md",
    "prepublishOnly": "npm run build && npm test",
    "demo": "serve ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darajoukar/reveal-rtl.git"
  },
  "homepage": "https://darajoukar.github.io/reveal-rtl/demo/",
  "bugs": "https://github.com/darajoukar/reveal-rtl/issues",
  "keywords": [
    "reveal.js",
    "reveal-js",
    "revealjs-plugin",
    "rtl",
    "persian",
    "farsi",
    "presentation"
  ],
  "author": "Dara Joukar",
  "license": "MIT",
  "peerDependencies": {
    "reveal.js": ">=6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "gifenc": "^1.0.3",
    "reveal.js": "6.0.2",
    "serve": "^14.2.6"
  }
}
